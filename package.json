{
  "name": "@vistyy/pi-herdr-agents",
  "version": "0.4.0",
  "description": "Owned Pi agents in Herdr tabs.",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "author": "Vistyy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vistyy/pi-herdr-agents.git"
  },
  "homepage": "https://github.com/Vistyy/pi-herdr-agents#readme",
  "bugs": {
    "url": "https://github.com/Vistyy/pi-herdr-agents/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "herdr",
    "agents"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "minimatch": "^10.2.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typebox": "^1.1.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
